# ============================================
# AstroMate Environment Variables
# ============================================

# Database (SQLite - free, local)
DATABASE_URL="file:./dev.db"

# Ollama (free local LLM)
# Install: https://ollama.ai | Run: ollama pull dolphin-llama3:8b
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="dolphin-llama3:8b"

# Auth secret - generate with: openssl rand -base64 32
JWT_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# NextAuth (if using NextAuth in future)
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SERVER_URL="http://localhost:3001"
SERVER_PORT=3001

# Premium (coming soon)
PREMIUM_COMING_SOON=true
