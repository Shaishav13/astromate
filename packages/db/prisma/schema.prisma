generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RelationshipLevel {
  STRANGER
  ACQUAINTANCE
  FRIEND
  CLOSE_FRIEND
  BEST_FRIEND
}

enum SubscriptionTier {
  FREE
  PRO
  PREMIUM
}

enum MessageRole {
  USER
  ASSISTANT
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  password         String
  country          String           @default("US")
  birthdate        DateTime?
  zodiacSign       String?
  personalitySeed  String?
  subscriptionTier SubscriptionTier @default(FREE)
  lastActiveAt     DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  mate            AstroMate?
  messages        Message[]
  memorySnapshots MemorySnapshot[]
  sessions        AuthSession[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model AstroMate {
  id                  String            @id @default(cuid())
  userId              String            @unique
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String            @default("Cosmo")
  buddyBirthTimestamp DateTime          @default(now())
  rashi               String?
  nakshatra           String?
  buddyZodiacSign     String?
  buddyPersonality    String?
  relationshipLevel   RelationshipLevel @default(STRANGER)
  relationshipScore   Float             @default(0)
  totalInteractions   Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Message {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MessageRole
  content     String
  isProactive Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([userId, createdAt])
}

model MemorySnapshot {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary           String
  messageRangeStart Int
  messageRangeEnd   Int
  createdAt         DateTime @default(now())

  @@index([userId])
}
