generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite does not support enums.
// All enum-like fields use String with enforced values in application code.
// Valid values:
//   relationshipLevel: STRANGER | ACQUAINTANCE | FRIEND | CLOSE_FRIEND | BEST_FRIEND
//   subscriptionTier:  FREE | PRO | PREMIUM
//   role:              USER | ASSISTANT

model User {
  id               String  @id @default(cuid())
  email            String  @unique
  name             String?
  password         String
  /// ISO 3166-1 alpha-2 country code e.g. "IN", "US"
  country          String  @default("US")
  birthdate        DateTime?
  /// Western zodiac sign of the user e.g. "scorpio"
  zodiacSign       String?
  /// JSON string of PersonalityTraits
  personalitySeed  String?
  /// FREE | PRO | PREMIUM
  subscriptionTier String  @default("FREE")
  lastActiveAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mate            AstroMate?
  messages        Message[]
  memorySnapshots MemorySnapshot[]
  sessions        AuthSession[]
  okfMemories     OkfMemory[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model AstroMate {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String   @default("Cosmo")
  /// Exact signup timestamp = buddy's birth moment for Vedic astrology
  buddyBirthTimestamp DateTime @default(now())
  /// Vedic Rashi e.g. "Vrishchik"
  rashi               String?
  /// Vedic Nakshatra e.g. "Jyeshtha"
  nakshatra           String?
  /// Western zodiac of the buddy e.g. "scorpio"
  buddyZodiacSign     String?
  /// JSON string of full buddy personality (Vedic + culture)
  buddyPersonality    String?
  /// STRANGER | ACQUAINTANCE | FRIEND | CLOSE_FRIEND | BEST_FRIEND
  relationshipLevel   String   @default("STRANGER")
  relationshipScore   Float    @default(0)
  totalInteractions   Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Message {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// USER | ASSISTANT
  role        String
  content     String
  isProactive Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model MemorySnapshot {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary           String
  messageRangeStart Int
  messageRangeEnd   Int
  createdAt         DateTime @default(now())

  @@index([userId])
}

model OkfMemory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// preference | milestone | inside_joke | celestial_observation | personal_fact
  type        String   @default("personal_fact")
  /// lifestyle | personal | work_study | humor | astrology
  category    String   @default("lifestyle")
  title       String
  /// JSON string array of tags e.g. ["food", "spicy", "ramen"]
  tags        String   @default("[]")
  confidence  Float    @default(0.9)
  /// Markdown content of the OKF memory
  content     String
  sourceRange String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, type])
  @@index([userId, category])
}

